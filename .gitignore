# Office lock files (created while a document is open)
~$*

# secrets — never committed (Vibe Coding rule)
.env
kaggle.json
*.pem

# data & generated artifacts (regenerated by the pipeline)
data/
logs/
*.log
spark-warehouse/
chroma/
__pycache__/
*.pyc
.ipynb_checkpoints/
standalone_admin_password.txt

# evidence of real runs is DELIBERATELY tracked — it is the rubric's proof
!evidence/**
# ...except Airflow's internal chatter (scheduler heartbeats, parser logs)
evidence/airflow_logs/scheduler/
evidence/airflow_logs/dag_processor_manager/
